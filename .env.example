# local | hybrid | llm-required
CHAT_MODE=hybrid

# Required only for live model calls. Never commit a real token.
HF_TOKEN=

# Replace with a chat-capable model available through your HF account.
HF_CHAT_MODEL=provider/model-name

# OpenAI-compatible Hugging Face Inference Providers endpoint.
HF_BASE_URL=https://router.huggingface.co/v1

LLM_TIMEOUT_MS=12000
LLM_MAX_OUTPUT_TOKENS=300
LLM_CONFIDENCE_THRESHOLD=0.70
